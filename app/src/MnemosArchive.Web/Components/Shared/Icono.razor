@* Iconos de trazo (24x24), en currentColor. Siempre acompañan a una palabra o llevan etiqueta. *@
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Nombre)
    {
        case "alerta":
            <path d="M12 3 2 20h20L12 3z" /><path d="M12 10v4" /><path d="M12 17.5v.01" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><path d="M12 7.5v.01" />
            break;
        case "ok":
            <path d="m5 12.5 4.5 4.5L19 7.5" />
            break;
        case "subir":
            <path d="M12 16V4" /><path d="m7 9 5-5 5 5" /><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" />
            break;
        case "tema":
            <circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" />
            break;
        case "tabla":
            <rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M9 10v9" />
            break;
        case "texto":
            <path d="M6 3h9l4 4v14H6z" /><path d="M14 3v5h5" /><path d="M9 13h7M9 17h5" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Nombre { get; set; } = "";
}
